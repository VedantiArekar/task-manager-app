source "https://rubygems.org"

ruby ">= 3.2.0"

# Web framework
gem "rails", "~> 8.0.0"

# PostgreSQL adapter used by Active Record
gem "pg", "~> 1.5"

# Web server (listens on port 3000 by default)
gem "puma", ">= 6.0"

# Time zone data for Windows
gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  # Loads variables from a local .env file (DATABASE_URL, PORT, ...)
  gem "dotenv-rails"
end

group :test do
  gem "minitest", "~> 5.25"
end
