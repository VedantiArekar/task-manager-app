<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Task Manager</title>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/style.css">
    <script src="/app.js" defer></script>
  </head>

  <body>
    <main class="container">
      <header>
        <h1><a href="<%= root_path %>">Task Manager</a></h1>
        <p class="subtitle">Create, track and complete your tasks</p>
      </header>

      <% flash.each do |type, message| %>
        <div class="message <%= type.to_s == "notice" ? "success" : "error" %>" role="alert">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
