<li class="task <%= "completed" if task.completed? %>">
  <div class="task-top">
    <h3 class="task-title"><%= link_to task.title, task_path(task) %></h3>
    <span class="badge <%= "completed" if task.completed? %>"><%= task.status %></span>
  </div>

  <% if task.description.present? %>
    <p class="task-desc"><%= truncate(task.description, length: 200) %></p>
  <% end %>

  <p class="task-meta">
    #<%= task.id %> · Created <%= format_time(task.created_at) %>
    <% if task.edited? %>
      · Updated <%= format_time(task.updated_at) %>
    <% end %>
  </p>

  <div class="task-actions">
    <%= button_to (task.completed? ? "Mark as Pending" : "Mark as Completed"),
                  toggle_task_path(task),
                  method: :patch,
                  class: "btn btn-small",
                  form_class: "inline-form" %>
    <%= link_to "Edit", edit_task_path(task), class: "btn btn-small" %>
    <%= button_to "Delete",
                  task_path(task),
                  method: :delete,
                  class: "btn btn-small btn-danger",
                  form_class: "inline-form",
                  form: { "data-confirm" => "Delete the task \"#{task.title}\"?" } %>
  </div>
</li>
