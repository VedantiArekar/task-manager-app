# Copy this file to .env and adjust the values. Never commit the real .env file.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://taskuser:mypass@localhost:5432/taskmanager

# Port the Rails server listens on
PORT=3000

# Number of web server threads / database connections
RAILS_MAX_THREADS=5

# Production only: generate a value with  bundle exec rails secret
# SECRET_KEY_BASE=
